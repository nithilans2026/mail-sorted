# Copy this file to .env.local and fill in the values yourself.
# Never commit .env.local or paste these values into chat.

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string. Generate one with:  npx auth secret   (or any password generator)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional: from console.anthropic.com. Leave empty to use keyword rules only (free).
ANTHROPIC_API_KEY=
# Model used for mails the rules can't place. Haiku is cheap; claude-opus-5-5 is more accurate.
CLAUDE_MODEL=claude-haiku-5-5
# Model used to translate mail when a non-English language is picked.
CLAUDE_TRANSLATE_MODEL=claude-sonnet-5-5
